# Copy to apps/api/.env and fill in. Never commit .env.
# Prisma, the api and scripts/smoke.ts all read this one file.
# Postgres (docker compose default)
DATABASE_URL=postgresql://proofvault:proofvault@localhost:5432/proofvault

# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id

# AI
ANTHROPIC_API_KEY=sk-ant-xxx

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173
STORE_ORIGIN=http://localhost:5174

# Required on every write route when set (approve, submit, offer, accept, sandbox steps, rules).
# Leave empty locally. Set it on Render.
DEMO_PASSCODE=
