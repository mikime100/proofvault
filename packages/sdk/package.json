{
  "name": "@proofvault/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Tracking snippet: the tracking number for digital goods. No dependencies, never throws.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs,iife --global-name ProofVault --dts --minify --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@proofvault/shared": "workspace:*",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0"
  }
}
